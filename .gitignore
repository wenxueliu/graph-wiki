.env
.DS_Store
*.pyc
__pycache__/

# Skill creator benchmark/review workspaces and local packages
.skills/*-workspace/
.skills/packages/

# Python build artifacts (pyproject.toml / `python -m build`)
/dist/
/build/
*.egg-info/

# Local vault — personal knowledge, never published with the framework
/vault/

# Packed browser extension (rebuildable from extensions/brain-capture/)
extensions/brain-capture/*.zip

# Local agent memory/log scratch (not framework source)
.remember/

# Agent skill mirrors (created by setup.py / `graph-wiki setup`) — pointers to
# the canonical .skills/ tree. They are install output, not source: regenerate
# them with `python3 setup.py` after cloning instead of tracking them.
.claude/skills/
.cursor/skills/
.windsurf/skills/
.agents/skills/
.pi/skills/
.kiro/skills/
.cac/skills/

# Generated Obsidian vault state inside examples
example/*/.obsidian/
